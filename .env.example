# Intended G3 stack: Mistral + tools + n8n calling FastAPI
LLM_PROVIDER=mistral
LLM_MODEL=mistral-small-latest

# Set your own key locally. Do not commit real secrets.
MISTRAL_API_KEY=your_mistral_api_key_here

# Other providers (optional / fallback only for local dev)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional: enforce a rough USD budget (requires price hints below).
# LLM_PRICE_INPUT_PER_1K=
# LLM_PRICE_OUTPUT_PER_1K=
# (Also set max_cost_usd_per_session via API body or ResearchConstraints in code.)

# Reproducible offline demo (deterministic tool outputs):
# RESEARCH_USE_MOCK_TOOLS=1

# If live search returns empty, optional automatic mock fallback:
# RESEARCH_AUTO_MOCK_ON_EMPTY=1
